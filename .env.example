# 复制为 .env 并填入密钥（.env 已被 gitignore，切勿提交）
# 在 Claude Code 云环境中，这些变量已在环境配置里设置，无需 .env

MINIMAX_API_KEY=        # MiniMax Token Plan 订阅 Key（sk-cp-…），默认供应商
DEEPSEEK_API_KEY=       # DeepSeek 按量付费 Key，备选 / 审稿
VOLC_SPEECH_API_KEY=    # 火山豆包语音 Key，TTS 备选
ARK_PAYG_API_KEY=       # 火山方舟「按量付费」Key（可选）。不要填 Coding Plan Key

# 注意：ARK_API_KEY（火山方舟 Coding Plan Key）仅供 AI 编程工具使用，本平台不读取它
