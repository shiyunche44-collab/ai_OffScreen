{
  "components": {
    "schemas": {
      "AssetDetail": {
        "properties": {
          "asset": {
            "$ref": "#/components/schemas/MediaAsset"
          },
          "stages": {
            "items": {
              "$ref": "#/components/schemas/StageStatus"
            },
            "title": "Stages",
            "type": "array"
          }
        },
        "required": [
          "asset",
          "stages"
        ],
        "title": "AssetDetail",
        "type": "object"
      },
      "AudioStream": {
        "additionalProperties": false,
        "properties": {
          "channels": {
            "exclusiveMinimum": 0.0,
            "title": "Channels",
            "type": "integer"
          },
          "index": {
            "minimum": 0.0,
            "title": "Index",
            "type": "integer"
          },
          "language": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Language"
          },
          "sample_rate": {
            "exclusiveMinimum": 0.0,
            "title": "Sample Rate",
            "type": "integer"
          }
        },
        "required": [
          "index",
          "channels",
          "sample_rate"
        ],
        "title": "AudioStream",
        "type": "object"
      },
      "CreateProject": {
        "properties": {
          "asset_id": {
            "pattern": "^ast_[0-9A-Za-z]+$",
            "title": "Asset Id",
            "type": "string"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Defaults to the asset's title.",
            "title": "Name"
          },
          "options": {
            "$ref": "#/components/schemas/ProjectOptions"
          }
        },
        "required": [
          "asset_id"
        ],
        "title": "CreateProject",
        "type": "object"
      },
      "DerivedFiles": {
        "additionalProperties": false,
        "description": "Paths relative to data_dir.",
        "properties": {
          "audio_16k": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Audio 16K"
          },
          "audio_48k": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Audio 48K"
          },
          "proxy": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Proxy"
          }
        },
        "title": "DerivedFiles",
        "type": "object"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "details": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "ImportAsset": {
        "properties": {
          "path": {
            "description": "A movie file under one of the media roots.",
            "minLength": 1,
            "title": "Path",
            "type": "string"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          }
        },
        "required": [
          "path"
        ],
        "title": "ImportAsset",
        "type": "object"
      },
      "Job": {
        "additionalProperties": false,
        "properties": {
          "attempt": {
            "default": 0,
            "minimum": 0.0,
            "title": "Attempt",
            "type": "integer"
          },
          "cache_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cache Key"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "finished_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "id": {
            "pattern": "^job_[0-9A-Za-z]+$",
            "title": "Id",
            "type": "string"
          },
          "lane": {
            "enum": [
              "gpu",
              "cpu",
              "api"
            ],
            "title": "Lane",
            "type": "string"
          },
          "log_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Log Path"
          },
          "message": {
            "default": "",
            "title": "Message",
            "type": "string"
          },
          "progress": {
            "default": 0.0,
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Progress",
            "type": "number"
          },
          "scope": {
            "additionalProperties": true,
            "default": {},
            "title": "Scope",
            "type": "object"
          },
          "stage": {
            "title": "Stage",
            "type": "string"
          },
          "started_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started At"
          },
          "status": {
            "default": "queued",
            "enum": [
              "queued",
              "running",
              "succeeded",
              "failed",
              "canceled"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "id",
          "stage",
          "lane",
          "created_at"
        ],
        "title": "Job",
        "type": "object"
      },
      "MediaAsset": {
        "additionalProperties": false,
        "properties": {
          "audio": {
            "items": {
              "$ref": "#/components/schemas/AudioStream"
            },
            "title": "Audio",
            "type": "array"
          },
          "derived": {
            "$ref": "#/components/schemas/DerivedFiles",
            "default": {}
          },
          "duration_ms": {
            "minimum": 0.0,
            "title": "Duration Ms",
            "type": "integer"
          },
          "fingerprint": {
            "pattern": "^sha256:[0-9a-f]{8,64}$",
            "title": "Fingerprint",
            "type": "string"
          },
          "id": {
            "pattern": "^ast_[0-9A-Za-z]+$",
            "title": "Id",
            "type": "string"
          },
          "schema_version": {
            "default": 1,
            "title": "Schema Version",
            "type": "integer"
          },
          "source_path": {
            "title": "Source Path",
            "type": "string"
          },
          "subtitles_external": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Subtitles External"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "video": {
            "$ref": "#/components/schemas/VideoInfo"
          }
        },
        "required": [
          "id",
          "title",
          "source_path",
          "fingerprint",
          "duration_ms",
          "video",
          "audio"
        ],
        "title": "MediaAsset",
        "type": "object"
      },
      "Project": {
        "additionalProperties": false,
        "properties": {
          "asset_id": {
            "pattern": "^ast_[0-9A-Za-z]+$",
            "title": "Asset Id",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "pattern": "^prj_[0-9A-Za-z]+$",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "options": {
            "$ref": "#/components/schemas/ProjectOptions"
          }
        },
        "required": [
          "id",
          "asset_id",
          "name",
          "created_at"
        ],
        "title": "Project",
        "type": "object"
      },
      "ProjectDetail": {
        "properties": {
          "project": {
            "$ref": "#/components/schemas/Project"
          },
          "stages": {
            "items": {
              "$ref": "#/components/schemas/StageStatus"
            },
            "title": "Stages",
            "type": "array"
          },
          "video": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Video"
          }
        },
        "required": [
          "project",
          "stages",
          "video"
        ],
        "title": "ProjectDetail",
        "type": "object"
      },
      "ProjectOptions": {
        "additionalProperties": false,
        "description": "How the commentary is written and voiced. Stages read these; changing them changes the\ncreative stages' cache keys, never the analysis.",
        "properties": {
          "minutes": {
            "default": 3.0,
            "exclusiveMinimum": 0.0,
            "maximum": 240.0,
            "title": "Minutes",
            "type": "number"
          },
          "spoil_ending": {
            "default": true,
            "title": "Spoil Ending",
            "type": "boolean"
          },
          "style": {
            "default": "neutral",
            "minLength": 1,
            "title": "Style",
            "type": "string"
          },
          "voice": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Voice"
          }
        },
        "title": "ProjectOptions",
        "type": "object"
      },
      "Rational": {
        "additionalProperties": false,
        "description": "Exact fraction, used for frame rates (23.976 -> 24000/1001).",
        "properties": {
          "den": {
            "exclusiveMinimum": 0.0,
            "title": "Den",
            "type": "integer"
          },
          "num": {
            "exclusiveMinimum": 0.0,
            "title": "Num",
            "type": "integer"
          }
        },
        "required": [
          "num",
          "den"
        ],
        "title": "Rational",
        "type": "object"
      },
      "StageStatus": {
        "properties": {
          "cached": {
            "title": "Cached",
            "type": "boolean"
          },
          "stage": {
            "title": "Stage",
            "type": "string"
          }
        },
        "required": [
          "stage",
          "cached"
        ],
        "title": "StageStatus",
        "type": "object"
      },
      "VideoInfo": {
        "additionalProperties": false,
        "properties": {
          "codec": {
            "title": "Codec",
            "type": "string"
          },
          "fps": {
            "$ref": "#/components/schemas/Rational"
          },
          "height": {
            "exclusiveMinimum": 0.0,
            "title": "Height",
            "type": "integer"
          },
          "width": {
            "exclusiveMinimum": 0.0,
            "title": "Width",
            "type": "integer"
          }
        },
        "required": [
          "width",
          "height",
          "fps",
          "codec"
        ],
        "title": "VideoInfo",
        "type": "object"
      }
    }
  },
