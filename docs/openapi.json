          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ImportAsset"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MediaAsset"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
