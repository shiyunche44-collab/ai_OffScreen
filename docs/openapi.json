  "paths": {
    "/assets": {
      "get": {
        "operationId": "list_assets_assets_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/MediaAsset"
                  },
                  "title": "Response List Assets Assets Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not allowed in the current state"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid input"
          }
        },
        "summary": "List Assets",
        "tags": [
          "assets"
        ]
      },
      "post": {
        "description": "Register a movie. Importing the same file again returns the same asset.",
        "operationId": "import_asset_assets_post",
