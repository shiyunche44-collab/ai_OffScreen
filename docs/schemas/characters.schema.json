{
  "$defs": {
    "Character": {
      "additionalProperties": false,
      "properties": {
        "aliases": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Aliases",
          "type": "array"
        },
        "bio": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bio"
        },
        "face_cluster": {
          "anyOf": [
            {
              "$ref": "#/$defs/FaceCluster"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "pattern": "^ch_[0-9A-Za-z]+$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "name_source": {
          "anyOf": [
            {
              "enum": [
                "ai",
                "human",
                "tmdb"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name Source"
        },
        "role": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        }
      },
      "required": [
        "id"
      ],
      "title": "Character",
      "type": "object"
    },
    "FaceCluster": {
      "additionalProperties": false,
      "properties": {
        "centroid_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Centroid Ref"
        },
        "size": {
          "minimum": 1,
          "title": "Size",
          "type": "integer"
        },
        "thumbnails": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Thumbnails",
          "type": "array"
        }
      },
      "required": [
        "size"
      ],
      "title": "FaceCluster",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "asset_id": {
      "pattern": "^ast_[0-9A-Za-z]+$",
      "title": "Asset Id",
      "type": "string"
    },
    "characters": {
      "items": {
        "$ref": "#/$defs/Character"
      },
      "title": "Characters",
      "type": "array"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "asset_id",
    "characters"
  ],
  "title": "Characters",
  "type": "object"
}
