{
  "$defs": {
    "Annotation": {
      "additionalProperties": false,
      "properties": {
        "message": {
          "title": "Message",
          "type": "string"
        },
        "segment_id": {
          "pattern": "^seg_[0-9A-Za-z]+$",
          "title": "Segment Id",
          "type": "string"
        },
        "type": {
          "enum": [
            "fact_check",
            "rule",
            "style"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "segment_id",
        "type",
        "message"
      ],
      "title": "Annotation",
      "type": "object"
    },
    "OutlineBeat": {
      "additionalProperties": false,
      "properties": {
        "beat": {
          "title": "Beat",
          "type": "string"
        },
        "focus": {
          "default": "",
          "title": "Focus",
          "type": "string"
        },
        "scene_refs": {
          "items": {
            "pattern": "^sc_[0-9A-Za-z]+$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Scene Refs",
          "type": "array"
        },
        "target_s": {
          "exclusiveMinimum": 0,
          "title": "Target S",
          "type": "integer"
        }
      },
      "required": [
        "beat",
        "scene_refs",
        "target_s"
      ],
      "title": "OutlineBeat",
      "type": "object"
    },
    "ScriptParams": {
      "additionalProperties": false,
      "properties": {
        "language": {
          "default": "zh",
          "title": "Language",
          "type": "string"
        },
        "perspective": {
          "default": "third",
          "enum": [
            "first",
            "third"
          ],
          "title": "Perspective",
          "type": "string"
        },
        "spoil_ending": {
          "default": true,
          "title": "Spoil Ending",
          "type": "boolean"
        },
        "style": {
          "title": "Style",
          "type": "string"
        },
        "target_duration_s": {
          "exclusiveMinimum": 0,
          "title": "Target Duration S",
          "type": "integer"
        },
        "voice_id": {
          "title": "Voice Id",
          "type": "string"
        }
      },
      "required": [
        "style",
        "target_duration_s",
        "voice_id"
      ],
      "title": "ScriptParams",
      "type": "object"
    },
    "ScriptSegment": {
      "additionalProperties": false,
      "properties": {
        "beat": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Beat"
        },
        "id": {
          "pattern": "^seg_[0-9A-Za-z]+$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "narration",
            "original"
          ],
          "title": "Kind",
          "type": "string"
        },
        "line_refs": {
          "default": [],
          "items": {
            "pattern": "^ln_[0-9A-Za-z]+$",
            "type": "string"
          },
          "title": "Line Refs",
          "type": "array"
        },
        "scene_refs": {
          "default": [],
          "items": {
            "pattern": "^sc_[0-9A-Za-z]+$",
            "type": "string"
          },
          "title": "Scene Refs",
          "type": "array"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "text"
      ],
      "title": "ScriptSegment",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "annotations": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Annotation"
      },
      "title": "Annotations",
      "type": "array"
    },
    "author": {
      "enum": [
        "ai",
        "human"
      ],
      "title": "Author",
      "type": "string"
    },
    "id": {
      "pattern": "^scr_[0-9A-Za-z]+$",
      "title": "Id",
      "type": "string"
    },
    "outline": {
      "default": [],
      "items": {
        "$ref": "#/$defs/OutlineBeat"
      },
      "title": "Outline",
      "type": "array"
    },
    "params": {
      "$ref": "#/$defs/ScriptParams"
    },
    "parent_version": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Version"
    },
    "project_id": {
      "pattern": "^prj_[0-9A-Za-z]+$",
      "title": "Project Id",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "segments": {
      "items": {
        "$ref": "#/$defs/ScriptSegment"
      },
      "title": "Segments",
      "type": "array"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "project_id",
    "version",
    "author",
    "params",
    "segments"
  ],
  "title": "Script",
  "type": "object"
}
