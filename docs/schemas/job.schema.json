{
  "additionalProperties": false,
  "properties": {
    "attempt": {
      "default": 0,
      "minimum": 0,
      "title": "Attempt",
      "type": "integer"
    },
    "cache_key": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cache Key"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "finished_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finished At"
    },
    "id": {
      "pattern": "^job_[0-9A-Za-z]+$",
      "title": "Id",
      "type": "string"
    },
    "lane": {
      "enum": [
        "gpu",
        "cpu",
        "api"
      ],
      "title": "Lane",
      "type": "string"
    },
    "log_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Log Path"
    },
    "message": {
      "default": "",
      "title": "Message",
      "type": "string"
    },
    "progress": {
      "default": 0.0,
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Progress",
      "type": "number"
    },
    "scope": {
      "additionalProperties": true,
      "default": {},
      "title": "Scope",
      "type": "object"
    },
    "stage": {
      "title": "Stage",
      "type": "string"
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At"
    },
    "status": {
      "default": "queued",
      "enum": [
        "queued",
        "running",
        "succeeded",
        "failed",
        "canceled"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "id",
    "stage",
    "lane",
    "created_at"
  ],
  "title": "Job",
  "type": "object"
}
