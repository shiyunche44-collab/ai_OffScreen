{
  "$defs": {
    "Annotation": {
      "additionalProperties": false,
      "properties": {
        "message": {
          "title": "Message",
          "type": "string"
        },
        "segment_id": {
          "pattern": "^seg_[0-9A-Za-z]+$",
          "title": "Segment Id",
          "type": "string"
        },
        "type": {
          "enum": [
            "fact_check",
            "rule",
            "style"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "segment_id",
        "type",
        "message"
      ],
      "title": "Annotation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "What the fact checker found in a script: annotations only, the text is never changed.",
  "properties": {
    "annotations": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Annotation"
      },
      "title": "Annotations",
      "type": "array"
    },
    "asset_id": {
      "pattern": "^ast_[0-9A-Za-z]+$",
      "title": "Asset Id",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "asset_id"
  ],
  "title": "ScriptReview",
  "type": "object"
}
