{
  "$defs": {
    "TranscriptLine": {
      "additionalProperties": false,
      "properties": {
        "end_ms": {
          "minimum": 0,
          "title": "End Ms",
          "type": "integer"
        },
        "id": {
          "pattern": "^ln_[0-9A-Za-z]+$",
          "title": "Id",
          "type": "string"
        },
        "speaker": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Speaker"
        },
        "start_ms": {
          "minimum": 0,
          "title": "Start Ms",
          "type": "integer"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "words": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Word"
          },
          "title": "Words",
          "type": "array"
        }
      },
      "required": [
        "start_ms",
        "end_ms",
        "id",
        "text"
      ],
      "title": "TranscriptLine",
      "type": "object"
    },
    "Word": {
      "additionalProperties": false,
      "properties": {
        "end_ms": {
          "minimum": 0,
          "title": "End Ms",
          "type": "integer"
        },
        "start_ms": {
          "minimum": 0,
          "title": "Start Ms",
          "type": "integer"
        },
        "w": {
          "title": "W",
          "type": "string"
        }
      },
      "required": [
        "start_ms",
        "end_ms",
        "w"
      ],
      "title": "Word",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "asset_id": {
      "pattern": "^ast_[0-9A-Za-z]+$",
      "title": "Asset Id",
      "type": "string"
    },
    "language": {
      "title": "Language",
      "type": "string"
    },
    "lines": {
      "items": {
        "$ref": "#/$defs/TranscriptLine"
      },
      "title": "Lines",
      "type": "array"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "source": {
      "title": "Source",
      "type": "string"
    }
  },
  "required": [
    "asset_id",
    "language",
    "source",
    "lines"
  ],
  "title": "Transcript",
  "type": "object"
}
