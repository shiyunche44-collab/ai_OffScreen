{
  "$defs": {
    "CastMember": {
      "additionalProperties": false,
      "properties": {
        "area_ratio": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Area Ratio",
          "type": "number"
        },
        "character_id": {
          "pattern": "^ch_[0-9A-Za-z]+$",
          "title": "Character Id",
          "type": "string"
        },
        "share": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Share",
          "type": "number"
        }
      },
      "required": [
        "character_id",
        "share",
        "area_ratio"
      ],
      "title": "CastMember",
      "type": "object"
    },
    "ShotCast": {
      "additionalProperties": false,
      "properties": {
        "characters": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CastMember"
          },
          "title": "Characters",
          "type": "array"
        },
        "shot_id": {
          "pattern": "^sh_[0-9A-Za-z]+$",
          "title": "Shot Id",
          "type": "string"
        }
      },
      "required": [
        "shot_id"
      ],
      "title": "ShotCast",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Who is on screen in each shot: what scene summaries and footage matching read, so they\nneed not know about faces.",
  "properties": {
    "asset_id": {
      "pattern": "^ast_[0-9A-Za-z]+$",
      "title": "Asset Id",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "shots": {
      "items": {
        "$ref": "#/$defs/ShotCast"
      },
      "title": "Shots",
      "type": "array"
    }
  },
  "required": [
    "asset_id",
    "shots"
  ],
  "title": "Cast",
  "type": "object"
}
