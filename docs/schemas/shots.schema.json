{
  "$defs": {
    "Shot": {
      "additionalProperties": false,
      "properties": {
        "end_ms": {
          "minimum": 0,
          "title": "End Ms",
          "type": "integer"
        },
        "id": {
          "pattern": "^sh_[0-9A-Za-z]+$",
          "title": "Id",
          "type": "string"
        },
        "keyframes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Keyframes",
          "type": "array"
        },
        "quality": {
          "anyOf": [
            {
              "$ref": "#/$defs/ShotQuality"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "start_ms": {
          "minimum": 0,
          "title": "Start Ms",
          "type": "integer"
        }
      },
      "required": [
        "start_ms",
        "end_ms",
        "id"
      ],
      "title": "Shot",
      "type": "object"
    },
    "ShotQuality": {
      "additionalProperties": false,
      "properties": {
        "brightness": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Brightness",
          "type": "number"
        },
        "sharpness": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Sharpness",
          "type": "number"
        }
      },
      "required": [
        "sharpness",
        "brightness"
      ],
      "title": "ShotQuality",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "asset_id": {
      "pattern": "^ast_[0-9A-Za-z]+$",
      "title": "Asset Id",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "shots": {
      "items": {
        "$ref": "#/$defs/Shot"
      },
      "title": "Shots",
      "type": "array"
    }
  },
  "required": [
    "asset_id",
    "shots"
  ],
  "title": "Shots",
  "type": "object"
}
