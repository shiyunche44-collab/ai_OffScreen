{
  "$defs": {
    "FaceBox": {
      "additionalProperties": false,
      "properties": {
        "area_ratio": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Area Ratio",
          "type": "number"
        },
        "bbox": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            }
          ],
          "title": "Bbox",
          "type": "array"
        },
        "character_id": {
          "anyOf": [
            {
              "pattern": "^ch_[0-9A-Za-z]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Character Id"
        },
        "embedding": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Embedding"
        },
        "frame": {
          "default": 0,
          "minimum": 0,
          "title": "Frame",
          "type": "integer"
        },
        "score": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        }
      },
      "required": [
        "bbox",
        "area_ratio"
      ],
      "title": "FaceBox",
      "type": "object"
    },
    "ShotFaces": {
      "additionalProperties": false,
      "properties": {
        "faces": {
          "items": {
            "$ref": "#/$defs/FaceBox"
          },
          "title": "Faces",
          "type": "array"
        },
        "shot_id": {
          "pattern": "^sh_[0-9A-Za-z]+$",
          "title": "Shot Id",
          "type": "string"
        }
      },
      "required": [
        "shot_id",
        "faces"
      ],
      "title": "ShotFaces",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "asset_id": {
      "pattern": "^ast_[0-9A-Za-z]+$",
      "title": "Asset Id",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "shots": {
      "items": {
        "$ref": "#/$defs/ShotFaces"
      },
      "title": "Shots",
      "type": "array"
    }
  },
  "required": [
    "asset_id",
    "shots"
  ],
  "title": "Faces",
  "type": "object"
}
